[Unit]
Description=PTT Relay Server
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/PTTServer
ExecStartPre=+/sbin/setcap cap_net_bind_service=+ep /home/YOUR_USERNAME/PTTServer/ptt-server
ExecStart=/home/YOUR_USERNAME/PTTServer/ptt-server
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
